{
  "name": "jest-canvas-mock-compare",
  "repository": {
    "type": "git",
    "url": "https://github.com/grafana/jest-canvas-mock-compare.git",
    "directory": "packages/jest-canvas-mock-compare"
  },
  "version": "0.0.2",
  "description": "Jest matchers for canvas snapshots with a visual diff workflow.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./constants": {
      "import": {
        "types": "./dist/constants.d.ts",
        "default": "./dist/constants.js"
      },
      "require": {
        "types": "./dist/constants.d.cts",
        "default": "./dist/constants.cjs"
      },
      "default": "./dist/constants.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "jest",
    "canvas",
    "snapshot",
    "visual-regression"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/constants.ts --format esm,cjs --dts --clean --tsconfig tsconfig.tsup.json --external jest --external jest-canvas-mock --external jest-snapshot --external expect",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --config jest.config.cjs",
    "prepublishOnly": "yarn run build && yarn run test"
  },
  "peerDependencies": {
    "jest": ">=29",
    "jest-canvas-mock": ">=2.5",
    "jest-snapshot": ">=29"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": false
    },
    "jest-canvas-mock": {
      "optional": false
    },
    "jest-snapshot": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-snapshot": "^30.3.0",
    "ts-jest": "29",
    "tsup": "^8.5.1",
    "typescript": "6.0.3"
  }
}
